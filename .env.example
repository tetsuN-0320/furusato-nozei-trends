# 楽天ウェブサービス アプリケーションID（UUID形式）
# 取得先: https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=your_rakuten_app_id_here

# 楽天ウェブサービス アクセスキー（pk_で始まる文字列）
RAKUTEN_ACCESS_KEY=your_rakuten_access_key_here

# オプション: アフィリエイトID（楽天アフィリエイト登録済みの場合）
RAKUTEN_AFFILIATE_ID=

# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
